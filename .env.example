TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_RESTART_NOTIFICATION_CHAT_ID=
BOT_DATA_DIR=./tmp/telegram-video-bot
TELEGRAM_LOCAL_API_PORT=18081
PORT=8080
YTDLP_AUTO_UPDATE=true

# Optional. Netscape cookies.txt for age-gated / login-walled videos (yt-dlp --cookies).
# Prefer a spare account. Never commit this file.
# Default fallback path if unset: $BOT_DATA_DIR/cookies.txt (when that file exists).
YTDLP_COOKIES_FILE=
